---
import Layout from '@/layouts/Layout.astro'; import Shell from '@/components/Shell.astro'; import {copy,getArticles,articlePath} from '@/lib/portfolio-content'; const c=copy['pt-BR']; const articles=getArticles('pt-BR');
---
<Layout title={`${c.blogTitle} — Gabriel Almir`} description={c.blogIntro} lang={c.lang} alternateHref="/en/blog"><Shell locale="pt-BR"><main id="main" class="index-page"><header><p class="kicker">04 / escrita</p><h1>{c.blogTitle}</h1><p>{c.blogIntro}</p></header><div class="article-grid">{articles.map(a=><a class={`article-card cover-${a.cover}`} href={articlePath('pt-BR',a.translationKey)}><span>{a.meta}</span><h2>{a.title}</h2><p>{a.excerpt}</p><i>↗</i></a>)}</div></main></Shell></Layout>
