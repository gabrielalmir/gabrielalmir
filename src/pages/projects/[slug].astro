---
import { getCollection } from 'astro:content';
import SystemDetail from '@/components/SystemDetail.astro';
export async function getStaticPaths() {
  const entries = await getCollection('systems', ({ data }) => data.locale === 'pt-BR');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<SystemDetail entry={entry} />
