---
import Layout from "@/layouts/Layout.astro";
import { Header } from "@/components/header";
---

<Layout
  title="404 — Página não encontrada | Gabriel Almir"
  description="A rota solicitada não existe."
>
  <Header client:idle />
  <main
    id="main"
    class="min-h-[calc(100vh-5rem)] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-16"
  >
    <div class="max-w-2xl w-full">
      <div
        class="rounded-2xl border border-vesper-orange/20 bg-background/60 backdrop-blur-sm p-6 sm:p-10 font-mono"
      >
        <div class="flex items-center gap-1.5 mb-6">
          <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
          <span class="ml-3 text-[11px] text-foreground/40">~/portfolio</span>
        </div>

        <pre
          class="text-sm sm:text-base leading-relaxed text-foreground/85 whitespace-pre-wrap"><span class="text-vesper-cyan">$</span> cat <span class="text-vesper-orange/90">{Astro.url.pathname}</span>
<span class="text-vesper-red">cat: {Astro.url.pathname}: No such file or directory</span>

<span class="text-vesper-cyan">$</span> ls -1 ~/portfolio
<span class="text-vesper-orange/80">/</span>            <span class="text-foreground/55"># home</span>
<span class="text-vesper-orange/80">/blog</span>        <span class="text-foreground/55"># artigos</span>
<span class="text-vesper-orange/80">/projects/saturno</span> <span class="text-foreground/55"># case study</span>
<span class="text-vesper-orange/80">/case-studies</span> <span class="text-foreground/55"># todos os cases</span>

<span class="text-vesper-cyan">$</span> <span class="text-foreground/55">_</span></pre>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-md bg-vesper-orange text-black font-semibold text-sm hover:bg-vesper-orange-light transition-colors"
          >
            ← Voltar pra home
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-md border border-vesper-orange/30 text-vesper-orange font-medium text-sm hover:bg-vesper-orange/10 transition-colors"
          >
            Ler o blog
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
