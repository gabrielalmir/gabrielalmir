---
import { aiSection } from '../lib/content';
import Arrow from './Arrow.astro';
---

<section id="ia" class="section shell" aria-labelledby="ai-title">
  <div class="section-heading ai-heading">
    <h2 id="ai-title">{aiSection.title}</h2>
    <div>
      <p class="lead">{aiSection.lead}</p>
      <p>{aiSection.body}</p>
      <a class="text-link" href="/projects/mcp-animaginexl">
        Ver o MCP AnimagineXL <Arrow />
      </a>
    </div>
  </div>
  <dl class="skill-list">
    {aiSection.skills.map((skill) => (
      <div class="skill-row">
        <dt>{skill.title}</dt>
        <dd>
          <span class="skill-label">Na prática</span>
          <p>{skill.demonstrated}</p>
        </dd>
        <dd>
          <span class="skill-label learning">Estou estudando</span>
          <p>{skill.learning}</p>
        </dd>
      </div>
    ))}
  </dl>
</section>
