---
/**
 * Processo — os quatro passos, um por tela.
 *
 * No modo capítulos (ver global.css) cada cartão é um passo do capítulo e
 * ocupa o palco sozinho; fora dele — sem JS, reduced-motion, mobile — são
 * quatro blocos normais, empilhados, com borda.
 */
import { Image } from 'astro:assets';
// Alias para não sombrear o global `process` do Node dentro do frontmatter.
import { process as processSection } from '../lib/content';
import { figureImages } from '../lib/images';
import Stroke from './marks/Stroke.astro';
---

<section
  id="processo"
  data-process
  data-chapter
  data-chapter-title="Processo"
  data-steps={String(processSection.steps.length + 1)}
  style={`--steps: ${processSection.steps.length + 1}; --plate: var(--plate-6)`}
  aria-labelledby="processo-titulo"
  class="bg-ink-900 py-28 md:py-40"
>
  <div data-chapter-stage>
  <div data-step class="u-shell">
    <header class="max-w-3xl" data-reveal-group>
      <p class="u-label text-blue-bright" data-reveal>{processSection.kicker}</p>
      <h2 id="processo-titulo" class="u-display text-section mt-6 text-paper" data-reveal>
        {processSection.title}
      </h2>
      <p class="mt-8 max-w-2xl text-ink-300" data-reveal>{processSection.lead}</p>
    </header>

    {/* Faixa de textura entre o cabeçalho e os cards: respiro, não ilustração de apoio. */}
    <figure class="mt-16 overflow-hidden border-y border-ink-800 md:mt-24" data-reveal>
      <Image
        src={figureImages.process}
        alt="Ilustração: retrato de Gabriel Almir a grafite sobre uma colagem de papéis rasgados, com arcos a lápis e recortes geométricos em azul e laranja."
        widths={[640, 960, 1200]}
        sizes="(min-width: 84rem) 84rem, 100vw"
        format="avif"
        loading="lazy"
        decoding="async"
        class="u-inked h-[clamp(10rem,26vw,20rem)] w-full object-cover object-[center_28%] opacity-40"
      />
    </figure>
  </div>

    {/* Um passo por cartão: no modo capítulos cada um ocupa a tela; fora dele
        são quatro blocos empilhados. */}
    <div class="u-shell mt-16 space-y-6 md:mt-24 md:space-y-10">
      {
        processSection.steps.map((step) => (
          <article
            data-process-card
            data-step
            class="process-card relative overflow-hidden border border-ink-700 bg-ink-850 px-7 py-10 md:px-14 md:py-16"
          >
            <span
              aria-hidden="true"
              class="u-display text-numeral pointer-events-none absolute -top-3 right-4 text-ink-500 select-none md:right-10"
            >
              {step.n}
            </span>

            {/* `relative` sem z-index: por vir depois no DOM, o texto já pinta sobre o numeral. */}
            <div class="relative max-w-2xl">
              <Stroke class="h-auto w-20 text-blue md:w-28" />
              <h3 class="u-display mt-6 text-4xl text-paper md:text-5xl">
                <span class="sr-only">Passo {step.n}. </span>
                {step.title}
              </h3>
              <p class="mt-4 max-w-[52ch] text-ink-300">{step.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* No modo capítulos o cartão vira a tela inteira: a borda e o fundo do
     bloco sobram, e o conteúdo se alinha ao shell como as outras seções.
     `.motion-ready` está no <html>, fora do escopo do componente. */
  @media (min-width: 768px) {
    :global(html.motion-ready.chapters) .process-card {
      border: 0;
      background-color: transparent;
      padding-inline: var(--spacing-gutter);
      max-width: 84rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
