---
import { Image } from 'astro:assets';
import graduation from '../assets/trajectory/graduation-upscaled.png';
import graduationOriginal from '../assets/trajectory/graduation-original.png';
import presentation from '../assets/trajectory/presentation-upscaled.png';
import presentationOriginal from '../assets/trajectory/presentation-original.png';
import junior from '../assets/trajectory/junior-goncalves.png';
import reginaldo from '../assets/trajectory/reginaldo-candido.png';
import Arrow from './Arrow.astro';
import { contact } from '../lib/content';
// Dados fornecidos pelo titular. URLs individuais só devem entrar após confirmação.
const certificates = [
  {
    title: 'Intermediate Machine Learning',
    issuer: 'Kaggle',
    date: 'nov. 2025',
    area: 'Machine learning',
    description: 'Aprofundamento em aprendizado de máquina, após o curso introdutório de 2024.',
  },
  {
    title: 'Machine Learning for Natural Language Processing',
    issuer: 'AWS Academy',
    date: 'jul. 2025',
    area: 'IA · NLP',
    description:
      'Curso de 20 horas sobre aprendizado de máquina aplicado ao processamento de linguagem natural.',
  },
  {
    title: 'Cloud Developing',
    issuer: 'AWS Academy',
    date: 'mai. 2025',
    area: 'Cloud',
    description:
      'Curso de 40 horas em desenvolvimento de aplicações na AWS, concluído em 17 de maio de 2025.',
  },
  {
    title: 'Introdução a OpenTelemetry',
    issuer: 'Full Cycle',
    date: 'ago. 2025',
    area: 'Observabilidade',
    description: 'Introdução à instrumentação de aplicações com métricas, logs e traces.',
  },
  {
    title: 'Arquitetura Hexagonal',
    issuer: 'Full Cycle',
    date: 'mar. 2025',
    area: 'Arquitetura',
    description: 'Organização de aplicações por responsabilidades, com ports e adapters.',
  },
  {
    title: 'Docker',
    issuer: 'Full Cycle',
    date: 'dez. 2024',
    area: 'Infraestrutura',
    description:
      'Módulo de 21 horas do treinamento Full Cycle 3.0, complementado por Docker na Prática em março de 2025.',
  },
];
---

<section class="learning shell" id="aprendizado" aria-labelledby="learning-title">
  <div class="heading">
    <div>
      <p class="eyebrow">Formação em prática</p>
      <h2 id="learning-title">Aprender, construir e compartilhar.</h2>
    </div>
    <p>
      Da sala de aula aos projetos.
      <br />
      Uma trajetória em desenvolvimento.
    </p>
  </div>
  <div class="photos">
    <figure>
      <Image
        src={graduation}
        alt="Fotografia original ampliada de cerimônia de formatura, com formando de beca e capelo acompanhado no palco."
        widths={[360, 600, 960]}
        sizes="(max-width: 767px) calc(100vw - 48px), 40vw"
        format="webp"
        loading="lazy"
      />
      <figcaption>
        <strong>Formação e conquistas</strong>
        <span>Um registro da minha formatura.</span>
        <span>
          Foto original ampliada ·{' '}
          <a href={graduationOriginal.src}>Ver foto original da formatura</a>
        </span>
      </figcaption>
    </figure>
    <figure>
      <Image
        src={presentation}
        alt="Fotografia original ampliada de apresentação em sala de aula, com código projetado e computadores nas mesas."
        widths={[360, 600, 960]}
        sizes="(max-width: 767px) calc(100vw - 48px), 40vw"
        format="webp"
        loading="lazy"
      />
      <figcaption>
        <strong>Conhecimento compartilhado</strong>
        <span>Apresentando e discutindo tecnologia em sala de aula.</span>
        <span>
          Foto original ampliada ·{' '}
          <a href={presentationOriginal.src}>Ver foto original da apresentação</a>
        </span>
      </figcaption>
    </figure>
  </div>
  <div class="heading certificates-heading">
    <div>
      <p class="eyebrow">Estudo contínuo</p>
      <h3>Cursos e certificados selecionados</h3>
    </div>
    <a class="text-link" href={contact.linkedin}>
      Ver perfil no LinkedIn <Arrow direction="up" />
    </a>
  </div>
  <p class="intro">
    Estudos que complementam minha experiência em backend e minha formação em IA. Os cursos AWS
    Academy são certificados de conclusão de formação acadêmica.
  </p>
  <div class="certificates">
    {certificates.map((item) => (
      <article>
        <p class="area">{item.area}</p>
        <h4>{item.title}</h4>
        <p class="issuer">
          {item.issuer} <span>· {item.date}</span>
        </p>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
  <details>
    <summary>Qualificação profissional e outros fundamentos</summary>
    <div class="additional">
      <article>
        <h4>Qualificação Profissional Desenvolvedor Back-end</h4>
        <p>Centro Paula Souza · abr. 2025</p>
        <p>
          Qualificação de 1.040 horas, correspondente aos componentes curriculares do curso de
          Desenvolvimento de Software Multiplataforma da FATEC Itapira.
        </p>
      </article>
      <article>
        <h4>Base complementar</h4>
        <p>Intro to Machine Learning · Kaggle · 3 set. 2024</p>
        <p>Fundamentos da Arquitetura de Software · Full Cycle · out. 2024</p>
        <p>SOLID Express · Full Cycle · jan. 2025</p>
        <p>Design Patterns · Centro Paula Souza · jul. 2024</p>
      </article>
    </div>
  </details>
  <div class="heading testimonials-heading">
    <div>
      <p class="eyebrow">Quem acompanhou meu caminho</p>
      <h3>Colaboração e comunicação.</h3>
    </div>
  </div>
  <div class="testimonials">
    <figure>
      <blockquote>
        “Destaco especialmente sua postura colaborativa, sempre disposto a compartilhar o que sabia
        e a ajudar no desenvolvimento coletivo da turma.”
      </blockquote>
      <figcaption>
        <Image
          src={junior}
          alt="Júnior Gonçalves"
          width={64}
          height={64}
          widths={[64, 128]}
          sizes="64px"
          format="webp"
          loading="lazy"
        />
        <div>
          <strong>Júnior Gonçalves</strong>
          <span>Professor de Gabriel · 31 mar. 2026</span>
        </div>
      </figcaption>
    </figure>
    <figure>
      <blockquote>
        “Além das competências de um desenvolvedor full-stack e mobile, possui conhecimentos sólidos
        e práticos em: Computação em Nuvem, Inteligência Artificial”
      </blockquote>
      <figcaption>
        <Image
          src={reginaldo}
          alt="Reginaldo Donizeti Cândido"
          width={64}
          height={64}
          widths={[64, 128]}
          sizes="64px"
          format="webp"
          loading="lazy"
        />
        <div>
          <strong>Reginaldo Donizeti Cândido</strong>
          <span>Professor de Ensino Superior FATEC · 12 jul. 2025</span>
        </div>
      </figcaption>
    </figure>
  </div>
  <p class="source">
    Trechos de recomendações recebidas no LinkedIn.{' '}
    <a href={contact.linkedin}>
      Visitar perfil <Arrow direction="up" />
    </a>
  </p>
</section>
<style>
  .testimonials figcaption {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .testimonials figcaption img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .testimonials figcaption div {
    min-width: 0;
  }

  figcaption a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .learning {
    padding-bottom: 72px;
  }
  .heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .eyebrow {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h2 {
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.04em;
    line-height: 1.2;
    margin-top: 12px;
  }
  h3 {
    font-size: 26px;
    letter-spacing: -0.03em;
    margin-top: 10px;
  }
  .heading > p,
  .intro {
    color: var(--muted);
    font-size: 14px;
  }
  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .photos figure {
    background: var(--work);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .photos img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center 48%;
  }
  .photos figure:nth-child(2) img {
    object-position: center 48%;
  }
  figcaption {
    padding: 20px 24px;
  }
  figcaption strong,
  figcaption span {
    display: block;
  }
  figcaption strong {
    font-size: 15px;
    font-weight: 550;
  }
  figcaption span {
    font-size: 12px;
    color: var(--muted);
    margin-top: 6px;
  }
  .certificates-heading,
  .testimonials-heading {
    margin-top: 48px;
  }
  .intro {
    max-width: 78ch;
    margin-bottom: 24px;
  }
  .certificates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .certificates article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .area {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 16px;
  }
  h4 {
    font-size: 17px;
    line-height: 1.4;
  }
  .issuer {
    font-size: 12px;
    margin: 12px 0;
  }
  .issuer span {
    color: var(--muted);
  }
  article > p:last-child {
    color: var(--muted);
    font-size: 13px;
  }
  details {
    margin-top: 24px;
    border-block: 1px solid var(--line);
  }
  summary {
    padding: 20px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
  }
  .additional {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding-bottom: 24px;
  }
  .additional p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 10px;
  }
  .testimonials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .testimonials figure {
    border-left: 2px solid var(--accent);
    background: var(--work);
    padding: 24px;
  }
  blockquote {
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
  }
  .testimonials figcaption {
    padding: 20px 0 0;
  }
  .source {
    color: var(--muted);
    font-size: 12px;
    margin-top: 20px;
  }
  .source a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
  }
  @media (max-width: 1000px) {
    .certificates {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .learning {
      padding-bottom: 44px;
    }
    .heading {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .photos,
    .certificates,
    .additional,
    .testimonials {
      grid-template-columns: 1fr;
    }
    .photos img {
      height: auto;
      max-height: 480px;
      object-fit: contain;
      background: var(--work);
    }
    .photos figure:nth-child(2) img {
      object-fit: contain;
    }
    .certificates-heading,
    .testimonials-heading {
      margin-top: 32px;
    }
  }
</style>
