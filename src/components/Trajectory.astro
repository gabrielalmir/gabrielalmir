---
import { trajectory, aboutSection, contact } from '../lib/content';
import Arrow from './Arrow.astro';
---

<section id="trajetoria" class="section shell" aria-labelledby="about-title">
  <div class="about-intro">
    <h2 id="about-title">{aboutSection.title}</h2>
    <div>
      <p class="lead">{trajectory.lead}</p>
      <p>{aboutSection.body}</p>
    </div>
  </div>
  <div class="about-layout">
    <div class="about-margin">
      <p class="label">Percurso profissional</p>
      <a class="text-link" href={contact.linkedin}>
        Perfil no LinkedIn <Arrow direction="up" />
      </a>
    </div>
    <ol class="career-list">
      {[...trajectory.career].reverse().map((entry) => (
        <li>
          <div class="career-meta">
            <span class="label">{entry.period}</span>
            {'now' in entry && entry.now && <span class="current label">Atual</span>}
          </div>
          <h3>{entry.org}</h3>
          <p class="career-role">{entry.role}</p>
          <p>{entry.summary}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="formation-grid">
    <div>
      <h3 class="label">Formação</h3>
      {trajectory.formation
        .slice(0, 2)
        .reverse()
        .map((entry) => (
          <article class="formation">
            <p class="label">{entry.period}</p>
            <h4>{entry.org}</h4>
            <p>{entry.role}</p>
          </article>
        ))}
    </div>
    <div>
      <h3 class="label">Competições de programação</h3>
      <p class="formation-note">{trajectory.note}</p>
      <ul class="competition-list">
        {trajectory.formation.slice(2).map((entry) => (
          <li>
            <span>{entry.org}</span>
            <span class="label">{entry.period}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="public-presence">
    <h3 class="label">Além do código</h3>
    {trajectory.publicPresence.map((entry) => (
      <a href={entry.href} class="presence-link">
        <span>
          <strong>{entry.org}</strong>
          <span>{entry.summary}</span>
        </span>
        <Arrow direction="up" />
      </a>
    ))}
  </div>
</section>
