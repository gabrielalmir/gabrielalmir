---
import { caseDiagrams, casePage } from '../lib/content';
interface Props {
  slug: string;
  compact?: boolean;
}
const { slug, compact = false } = Astro.props;
const diagram = caseDiagrams[slug as keyof typeof caseDiagrams];
if (!diagram) throw new Error(`Diagrama ausente para ${slug}`);
---

<figure class:list={['case-diagram', `diagram-${slug}`, compact && 'diagram-compact']}>
  <div class="label diagram-caption">
    <span>{casePage.diagram}</span>
    <span aria-hidden="true">
      {slug === 'mcp-animaginexl'
        ? 'MCP / Python / Diffusers'
        : slug === 'pimbas'
          ? 'Domínio / Migração'
          : slug === 'maybe'
            ? 'PHP 7.4 / Contratos'
            : 'Fluxo de dados'}
    </span>
  </div>
  <svg class="diagram-desktop" viewBox="0 0 540 260" aria-hidden="true" focusable="false">
    {slug === 'mcp-animaginexl' ? (
      <>
        <rect x="20" y="20" width="210" height="68" />
        <text x="125" y="48" text-anchor="middle">
          Agente MCP
        </text>
        <text class="diagram-note" x="125" y="70" text-anchor="middle">
          Chamada de ferramenta
        </text>
        <path class="connector" d="M230 54h80M415 88v82M310 204h-80" />
        <rect x="310" y="20" width="210" height="68" />
        <text x="415" y="48" text-anchor="middle">
          Ferramentas MCP
        </text>
        <text class="diagram-note" x="415" y="70" text-anchor="middle">
          Preparar / validar / gerar
        </text>
        <rect x="310" y="170" width="210" height="68" />
        <text x="415" y="198" text-anchor="middle">
          Diffusers + modelo local
        </text>
        <text class="diagram-note" x="415" y="220" text-anchor="middle">
          Execução no hardware
        </text>
        <rect x="20" y="170" width="210" height="68" />
        <text x="125" y="198" text-anchor="middle">
          Imagem + parâmetros
        </text>
        <text class="diagram-note" x="125" y="220" text-anchor="middle">
          Arquivos PNG e JSON
        </text>
      </>
    ) : slug === 'pimbas' ? (
      <>
        <rect x="20" y="35" width="145" height="52" />
        <text x="92" y="67" text-anchor="middle">
          Fastify + web
        </text>
        <path class="connector" d="M165 61h70v57h50" />
        <rect x="285" y="91" width="235" height="58" />
        <text x="402" y="126" text-anchor="middle">
          Next.js consolidado
        </text>
        <path class="connector" d="M92 87v118h310v-56" />
        <rect x="20" y="179" width="220" height="52" />
        <text x="130" y="211" text-anchor="middle">
          Partidas / ranking / torneios
        </text>
        <text class="diagram-note" x="404" y="228" text-anchor="middle">
          Acesso por grupo
        </text>
      </>
    ) : slug === 'maybe' ? (
      <>
        <rect x="20" y="92" width="145" height="62" />
        <text x="92" y="128" text-anchor="middle">
          Schema + DTO
        </text>
        <path class="connector" d="M165 123h90m0 0v-65h90m-90 65v65h90" />
        <rect x="345" y="32" width="175" height="52" />
        <text x="432" y="64" text-anchor="middle">
          Result: Ok / Err
        </text>
        <rect x="345" y="162" width="175" height="52" />
        <text x="432" y="194" text-anchor="middle">
          Option: Some / None
        </text>
        <circle cx="255" cy="123" r="4" />
        <text class="diagram-note" x="92" y="188" text-anchor="middle">
          Dados na borda
        </text>
      </>
    ) : slug === 'saturno' ? (
      <>
        <rect x="20" y="20" width="500" height="220" class="diagram-container" />
        <text class="diagram-note" x="42" y="49">
          Laravel + Inertia / uma unidade de deploy
        </text>
        <rect x="42" y="91" width="200" height="58" />
        <text x="142" y="126" text-anchor="middle">
          Organização + acesso
        </text>
        <path class="connector" d="M242 120h46" />
        <rect x="288" y="91" width="210" height="58" />
        <text x="393" y="126" text-anchor="middle">
          WorkManagement
        </text>
        <text class="diagram-note" x="270" y="205" text-anchor="middle">
          Fronteira modular dentro do monólito
        </text>
      </>
    ) : slug === 'hush' ? (
      <>
        <rect x="20" y="72" width="130" height="60" />
        <text x="85" y="108" text-anchor="middle">
          RESP
        </text>
        <path class="connector" d="M150 102h40m140 0h40" />
        <rect x="190" y="72" width="140" height="60" />
        <text x="260" y="108" text-anchor="middle">
          Fila concorrente
        </text>
        <rect x="370" y="72" width="150" height="60" />
        <text x="445" y="108" text-anchor="middle">
          Estado em memória
        </text>
        <path class="connector" d="M445 132v58H260" />
        <text x="260" y="217" text-anchor="middle">
          LRU + TTL
        </text>
        <text class="diagram-note" x="85" y="211" text-anchor="middle">
          Sem persistência
        </text>
      </>
    ) : (
      <>
        <rect x="20" y="92" width="130" height="60" />
        <text x="85" y="128" text-anchor="middle">
          Operação
        </text>
        <path class="connector" d="M150 122h50m140 0h35v-64h30m-30 64v64h30" />
        <rect x="200" y="92" width="140" height="60" />
        <text x="270" y="128" text-anchor="middle">
          Result: Ok / Err
        </text>
        <text x="455" y="64" text-anchor="middle">
          ESM
        </text>
        <text x="455" y="192" text-anchor="middle">
          CJS
        </text>
        <text class="diagram-note" x="270" y="231" text-anchor="middle">
          O mesmo contrato nos dois formatos
        </text>
      </>
    )}
  </svg>
  <svg
    class="diagram-mobile"
    viewBox={`0 0 300 ${diagram.nodes.length * 82 + 10}`}
    aria-hidden="true"
    focusable="false"
  >
    {diagram.nodes.map((node, index) => (
      <g>
        {index < diagram.nodes.length - 1 && (
          <path class="connector" d={`M150 ${index * 82 + 66}v26`} />
        )}
        <rect x="10" y={index * 82 + 10} width="280" height="56" />
        <text x="150" y={index * 82 + 34} text-anchor="middle">
          {node.label}
        </text>
        <text class="diagram-note" x="150" y={index * 82 + 53} text-anchor="middle">
          {node.note}
        </text>
      </g>
    ))}
  </svg>
  <figcaption class="sr-only">{diagram.description}</figcaption>
</figure>
