---
/**
 * Navegação de capítulos — os pontos na borda direita e o marcador no rodapé.
 *
 * Os pontos são âncoras de verdade: nascem visíveis a partir de `md` e
 * funcionam sem JS, como qualquer lista de links. `aria-current` sai no
 * primeiro em build e é o motion (src/motion/chapters.ts) que o move.
 *
 * O marcador "Capítulo 03 / Sistemas" é cromo decorativo: duplica o kicker
 * que cada seção já mostra, por isso é `aria-hidden` e só aparece no modo
 * capítulos (ver global.css).
 */
import { chapters } from '../lib/content';

const pad = (n: number) => String(n).padStart(2, '0');
---

<nav
  data-chapter-nav
  aria-label="Capítulos"
  class="fixed top-1/2 right-4 z-80 hidden -translate-y-1/2 md:block lg:right-6"
>
  <ol class="flex flex-col gap-3">
    {
      chapters.map((chapter, index) => (
        <li>
          <a
            href={`#${chapter.id}`}
            data-chapter-dot={index}
            aria-current={index === 0 ? 'true' : undefined}
            class="chapter-dot"
          >
            <svg class="chapter-ring" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle data-chapter-ring cx="12" cy="12" r="10" />
            </svg>
            <span class="sr-only">
              Capítulo {pad(index + 1)} — {chapter.title}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<div
  data-chapter-marker
  aria-hidden="true"
  class="u-label pointer-events-none fixed bottom-6 left-[var(--spacing-gutter)] z-80 items-baseline gap-3 text-ink-400"
>
  <span data-chapter-marker-number>Capítulo 01</span>
  <span class="text-ink-600">/</span>
  <span data-chapter-marker-title class="text-paper">{chapters[0].title}</span>
</div>

<style>
  .chapter-dot {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
  }

  /* O ponto em si. */
  .chapter-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: var(--color-ink-500);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.35s var(--ease-ink),
      transform 0.35s var(--ease-ink);
  }

  .chapter-dot:hover::after,
  .chapter-dot:focus-visible::after,
  .chapter-dot[aria-current='true']::after {
    background-color: var(--color-paper);
  }

  .chapter-dot[aria-current='true']::after {
    transform: translate(-50%, -50%) scale(1.15);
  }

  /* O anel de progresso: só o capítulo ativo o mostra, e quem gira o
     dashoffset é o motion, com o progresso dentro do capítulo. */
  .chapter-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    opacity: 0;
    transition: opacity 0.35s var(--ease-ink);
  }

  .chapter-ring circle {
    fill: none;
    stroke: var(--color-blue);
    stroke-width: 1;
    stroke-dasharray: 62.83;
    stroke-dashoffset: 62.83;
  }

  .chapter-dot[aria-current='true'] .chapter-ring {
    opacity: 1;
  }
</style>
