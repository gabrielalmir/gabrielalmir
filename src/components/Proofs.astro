---
import { proofs } from '../lib/content';
import Arrow from './Arrow.astro';
---

<section id="provas" class="proof-section" aria-labelledby="proofs-title">
  <div class="shell">
    <h2 id="proofs-title" class="label">
      {proofs.title}
    </h2>
    <div class="proof-grid">
      {proofs.items.map((item, index) => (
        <article class="proof">
          <p class:list={['proof-mark', index === 0 && 'proof-number']}>{item.mark}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {'href' in item && (
            <a href={item.href} class="text-link">
              {item.linkLabel} <Arrow direction="up" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
