---
/**
 * Uma etapa da trajetória — o `<li>` que Trajectory.astro repete nos três
 * grupos. Extraído para que a carreira (um passo de capítulo por item) e as
 * grades de formação e presença pública sejam exatamente o mesmo HTML.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Splatter from './marks/Splatter.astro';
import type { TrajectoryEntry } from '../lib/content';
import { trajectoryImage } from '../lib/images';

interface Props {
  item: TrajectoryEntry;
  itemClass: string;
  /** Marca o item como passo do capítulo (só a carreira). */
  step?: boolean;
}

const { item, itemClass, step = false } = Astro.props;

// photogimp.png é um ícone 512×512, não uma fotografia: entra pequeno e sem
// `u-inked`, que existe para reprojetar fotos dentro da paleta.
const ICON_IMAGE = 'photogimp';
const image = trajectoryImage(item.image);
const isIcon = item.image === ICON_IMAGE;
---

<li
  class={itemClass}
  data-trajectory-item={item.year}
  data-trajectory-now={item.now ? '' : undefined}
  data-step={step ? '' : undefined}
>
  <span
    class="absolute top-3 left-0 block size-2.5 -translate-x-1/2 rounded-full border border-ink-600 bg-ink-900"
    aria-hidden="true"
  >
    {item.now && (
      <Splatter class="absolute top-1/2 left-1/2 h-10 w-10 -translate-x-1/2 -translate-y-1/2 text-red" />
    )}
  </span>

  <span class="u-display block text-5xl leading-none text-blue">{item.year}</span>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="u-label text-ink-400">{item.period}</span>
    {item.now && <span class="u-label text-red">agora</span>}
  </div>

  <p class="mt-5 text-2xl text-paper">
    {item.href ? (
      <a class="link-ink inline-flex items-center gap-2" href={item.href} target="_blank" rel="noreferrer">
        {item.org}
        <Icon name="external-link" size={16} label="abre em nova aba" />
      </a>
    ) : (
      item.org
    )}
  </p>

  <p class="mt-1 text-base font-medium text-ink-300">{item.role}</p>
  <p class="mt-4 text-base text-ink-300">{item.summary}</p>

  {image && item.imageAlt && (
    <figure class={isIcon ? 'mt-6' : 'mt-6 max-w-xs'}>
      <Image
        src={image}
        alt={item.imageAlt}
        width={isIcon ? 64 : 320}
        densities={[1, 2]}
        format={isIcon ? 'webp' : 'avif'}
        loading="lazy"
        decoding="async"
        class={isIcon ? 'size-16' : 'u-inked aspect-[960/691] w-full rounded-sm object-cover'}
      />
    </figure>
  )}
</li>

<style>
  /* No modo capítulos o item ocupa o palco: o fio da hairline à esquerda e o
     bullet, que faziam sentido numa lista, saem; o conteúdo alinha ao shell. */
  @media (min-width: 768px) {
    :global(html.motion-ready.chapters) [data-trajectory-item][data-step] {
      border-left: 0;
      padding-inline: var(--spacing-gutter);
      max-width: 84rem;
      margin-inline: auto;
      width: 100%;
    }

    :global(html.motion-ready.chapters) [data-trajectory-item][data-step] > span[aria-hidden]:first-child {
      display: none;
    }
  }
</style>
