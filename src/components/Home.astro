---
import Shell from './Shell.astro'; import { copy, getArticles, articlePath, type Locale } from '@/lib/portfolio-content';
const { locale='pt-BR' }=Astro.props as {locale:Locale}; const c=copy[locale]; const articles=getArticles(locale);
const workId=locale==='en'?'work':'trabalhos', processId=locale==='en'?'process':'processo';
---
<Shell locale={locale}>
<main id="main">
 <section class="hero grid-paper"><div class="hero-copy" data-reveal><p class="kicker">{c.heroKicker}</p><h1>{c.heroTitle}</h1><p class="lede">{c.heroBody}</p><div class="actions"><a class="button ink" href={`#${workId}`}>{c.heroPrimary} <span>↓</span></a><a class="button" href={locale==='en'?'/en/blog':'/blog'}>{c.heroSecondary} <span>↗</span></a></div></div><figure class="hero-portrait" data-reveal><img src="/images/editorial/gabriel-hero.webp" width="800" height="1000" alt={locale==='en'?'Editorial portrait of Gabriel Almir':'Retrato editorial de Gabriel Almir'} fetchpriority="high"><figcaption>{locale==='en'?'Between systems, ideas, and good questions.':'Entre sistemas, ideias e boas perguntas.'}</figcaption></figure><span class="margin-note">{locale==='en'?'systems / people / learning':'sistemas / pessoas / aprendizado'}</span></section>
 <section class="proof"><header><p class="kicker">00 / {locale==='en'?'brief':'síntese'}</p><h2>{c.proofTitle}</h2></header><div>{c.proofs.map(([metric,title,text],i)=><article data-reveal><span class="index">0{i+1}</span><strong>{metric}</strong><h3>{title}</h3><p>{text}</p></article>)}</div></section>
 <section class="section work" id={workId}><header class="section-head"><p class="kicker">01 / {locale==='en'?'selected work':'trabalhos'}</p><h2>{c.workTitle}</h2><p>{c.workIntro}</p></header><div class="story-list">{c.stories.map((story,i)=><article data-reveal><header><span class="index">{story.n}</span><p class="kicker">{story.tag}</p><h3>{story.title}</h3></header><div class="story-path"><div><small>{locale==='en'?'Constraint':'Restrição'}</small><p>{story.constraint}</p></div><div><small>{locale==='en'?'Decision':'Decisão'}</small><p>{story.decision}</p></div><div><small>{locale==='en'?'Result':'Resultado'}</small><p>{story.result}</p></div></div><a class="text-link" href={story.href}>{story.label} <span>↗</span></a></article>)}</div></section>
 <section class="section process grid-paper" id={processId}><header class="section-head"><p class="kicker">02 / {locale==='en'?'behind the scenes':'bastidores'}</p><h2>{c.processTitle}</h2><p>{c.processBody}</p></header><ol>{c.processSteps.map(([n,title,text])=><li data-reveal><span>{n}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
 <section class="personal"><figure data-reveal><img src="/images/editorial/gabriel-process.webp" width="1200" height="675" loading="lazy" alt={locale==='en'?'Gabriel among visual process marks':'Gabriel entre marcas visuais de processo'}><figcaption>{locale==='en'?'Thinking is also a way of building.':'Pensar também é uma forma de construir.'}</figcaption></figure><div data-reveal><p class="kicker">03 / {locale==='en'?'personal layer':'camada pessoal'}</p><h2>{c.personalTitle}</h2><p>{c.personalBody}</p><aside><img src="/me.webp" width="800" height="800" loading="lazy" alt="Gabriel Almir"><span>{locale==='en'?'Curiosity in its natural state.':'Curiosidade em estado natural.'}</span></aside></div></section>
 <section class="section writing"><header class="section-head"><p class="kicker">04 / {locale==='en'?'writing':'escrita'}</p><h2>{c.writingTitle}</h2></header><div class="article-grid">{articles.map(a=><a class={`article-card cover-${a.cover}`} href={articlePath(locale,a.translationKey)} data-reveal><span>{a.meta}</span><h3>{a.title}</h3><p>{a.excerpt}</p><i>↗</i></a>)}</div></section>
 <section class="contact" id="contato"><p class="kicker">05 / {locale==='en'?'contact':'contato'}</p><h2>{c.contactTitle}</h2><p>{c.contactBody}</p><a class="button ink" href="mailto:contato@gabrielalmir.com">{c.email} <span>↗</span></a></section>
</main></Shell>
