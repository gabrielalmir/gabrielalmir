---
/**
 * Tela de abertura: um pincel escreve o "A" da marca.
 *
 * O desenho é o próprio `brand-mark.svg`, redesenhado aqui em duas camadas:
 *
 *  - uma MÁSCARA com as formas cheias do glifo, que é o que dá a silhueta
 *    verdadeira da marca, com as barrigas e as pontas afiladas;
 *  - por baixo dela, três traços de esqueleto grossos que são "pintados" por
 *    stroke-dashoffset, na ordem em que a mão escreveria: a diagonal principal
 *    de cima para baixo, depois a perna, depois o respingo do meio.
 *
 * O efeito não é um contorno sendo traçado — é tinta enchendo a letra, que é o
 * que um pincel de fato faz. O nariz do pincel corre pelo mesmo esqueleto, via
 * MotionPath, então ele está sempre exatamente na ponta do traço.
 *
 * Nada aqui é conteúdo: a marcação inteira nasce com `hidden` e só sai dele se
 * `src/motion/preloader.ts` decidir que há movimento liberado e que a sessão
 * ainda não viu a abertura. Sem JS, é markup morto de ~1 KB.
 */
const GLYPH = [
  // Perna esquerda.
  'M6 43c4-.8 5.8-3.3 7.7-7.7L22 15.1l3.3 6.8-8.2 17.2c-.8 1.8.2 3 3.5 3.9H6Z',
  // Diagonal principal, com a virada no pé.
  'M18.2 7.7c4.8-1.8 8.1 1.2 10.4 6.8l8.7 21c1.8 4.2 4.5 6.3 8.7 7.2-3.8 2.6-8.7 2.7-12-.5-2.9-2.8-4.6-7.7-6.7-12.8L21.6 15c-1.3-3.5-1.5-5.8-3.4-7.3Z',
  // Travessão do meio — o acento da marca.
  'M15.4 31.8c4.2-3.5 8.4-5.6 13.3-7l1 2.3c-5.6 1-10.2 2.6-15.7 7.1l1.4-2.4Z',
];

/**
 * Esqueletos, na ordem de escrita. São as linhas de centro de cada forma do
 * glifo: o traço grosso que corre por elas transborda a silhueta, e a máscara
 * apara a sobra. Por isso a precisão aqui é de gesto, não de contorno.
 */
const STROKES = [
  { d: 'M19.6 9.4C24.6 8.4 27.5 13 29.7 18.9L37.5 37.6C39.7 42.1 42.7 43.7 45.7 43.4', width: 15 },
  { d: 'M23.5 18.2L15.6 34.7C13.8 38.7 11 41.8 6.7 43.2', width: 13 },
  { d: 'M15.8 32.5C20 29.4 24.5 27.4 29 26.3', width: 7 },
];
---

<div
  id="preloader"
  data-preloader-curtain
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-150 grid place-items-center bg-ink-950"
  hidden
>
  <svg
    data-preloader-mark
    viewBox="0 0 48 48"
    class="h-[clamp(6rem,18vmin,11rem)] w-[clamp(6rem,18vmin,11rem)] overflow-visible"
    fill="none"
    aria-hidden="true"
  >
    <defs>
      <mask id="ga-glyph" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
        <rect width="48" height="48" fill="#000"></rect>
        {GLYPH.map((d) => <path d={d} fill="#fff" />)}
      </mask>
    </defs>

    {/* O papel: a marca em cinza fundo, para o traço ter onde cair. */}
    <g class="text-ink-800">
      {GLYPH.map((d) => <path d={d} fill="currentColor" opacity="0.5" />)}
    </g>

    {/* A tinta. O traço é grosso e a máscara é que lhe dá a forma da letra. */}
    <g mask="url(#ga-glyph)">
      {
        STROKES.map((stroke, index) => (
          <path
            data-preloader-stroke
            data-stroke-index={index}
            d={stroke.d}
            stroke="currentColor"
            stroke-width={stroke.width}
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            class="text-paper"
          />
        ))
      }
    </g>

    {/*
      O pincel. A cerda é uma gota afilada — larga onde encosta no papel,
      fininha na virola — e o cabo sai para trás, na direção de onde a mão
      viria. Pequeno de propósito: ele marca a ponta da tinta, não disputa
      atenção com a letra que está sendo escrita.
    */}
    <g data-preloader-brush opacity="0">
      <path
        d="M2.6 0C2.2 0.85 1.2 1.55 -0.6 2.05 -1.35 1.25 -1.7 0.65 -1.7 0 -1.7 -0.65 -1.35 -1.25 -0.6 -2.05 1.2 -1.55 2.2 -0.85 2.6 0Z"
        class="fill-paper"
      ></path>
      <path
        d="M-1.9 0 -3.1 0"
        class="stroke-blue-bright"
        stroke-width="1.5"
        stroke-linecap="butt"
      ></path>
      <path
        d="M-3.4 0 -7.6 0"
        class="stroke-ink-600"
        stroke-width="0.85"
        stroke-linecap="round"
      ></path>
    </g>
  </svg>
</div>
