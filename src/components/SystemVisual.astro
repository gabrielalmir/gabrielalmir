---
interface Props {
  slug: string;
  label: string;
  compact?: boolean;
}
const { slug, label, compact = false } = Astro.props;
---

<figure class:list={['system-visual', { compact }]} aria-label={label} role="img">
  <img
    src={`/images/atlas/${slug}.png`}
    width={compact ? 240 : 720}
    height={compact ? 240 : 480}
    loading="lazy"
    alt=""
  />
  <figcaption>{label}</figcaption>
</figure>
