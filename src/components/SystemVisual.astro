---
interface Props {
  slug: string;
  label: string;
  compact?: boolean;
}
const { slug, label, compact = false } = Astro.props;
---

<figure class:list={['system-visual', { compact }]} aria-label={label} role="img">
  <svg viewBox="0 0 240 160" aria-hidden="true" focusable="false">
    <path
      class="visual-grid"
      d="M0 40h240M0 80h240M0 120h240M40 0v160M80 0v160M120 0v160M160 0v160M200 0v160"></path>
    {
      slug === 'pimbas' && (
        <g>
          <>
            <rect x="25" y="25" width="190" height="110" rx="8" />
            <path d="M120 25v110M25 80h190" />
            <circle cx="120" cy="80" r="20" />
            <circle class="fill-amber" cx="72" cy="54" r="8" />
            <circle class="fill-blue" cx="168" cy="106" r="8" />
            <path class="accent" d="m68 67 27 20 30-9 43 15" />
          </>
        </g>
      )
    }
    {
      slug === 'maybe' && (
        <g>
          <>
            <path d="M30 80h40l18-30 28 60 25-45 20 15h49" />
            <circle class="fill-blue" cx="30" cy="80" r="9" />
            <path class="fill-amber" d="m116 110 12-21h-24z" />
            <rect class="fill-green" x="181" y="71" width="18" height="18" rx="3" />
            <path class="accent" d="M65 125h110" />
          </>
        </g>
      )
    }
    {
      slug === 'saturno' && (
        <g>
          <>
            <circle cx="120" cy="80" r="34" />
            <ellipse
              class="accent"
              cx="120"
              cy="80"
              rx="88"
              ry="27"
              transform="rotate(-12 120 80)"
            />
            <circle class="fill-blue" cx="120" cy="80" r="10" />
            <circle class="fill-amber" cx="194" cy="59" r="7" />
            <path d="M57 29h34M149 131h34" />
          </>
        </g>
      )
    }
    {
      slug === 'mcp-animaginexl' && (
        <g>
          <>
            <rect x="30" y="28" width="180" height="104" rx="6" />
            <path d="m45 113 38-42 27 25 24-20 60 37" />
            <circle class="fill-amber" cx="165" cy="57" r="13" />
            <path class="accent" d="M15 48h26M199 112h26" />
          </>
        </g>
      )
    }
    {
      slug === 'mcp-qwen3-tts' && (
        <g>
          <>
            <path
              class="accent"
              d="M22 80h18l9-34 15 68 16-54 14 38 16-72 15 108 15-70 14 28 13-46 15 68 10-34h26"
            />
            <circle class="fill-blue" cx="22" cy="80" r="6" />
            <circle class="fill-amber" cx="218" cy="80" r="6" />
          </>
        </g>
      )
    }
    {
      slug === 'hush' && (
        <g>
          <>
            <path d="M35 45h170v70H35z" />
            <path class="accent" d="M52 62h56v36H52zM126 62h62M126 80h48M126 98h32" />
            <circle class="fill-green" cx="52" cy="132" r="7" />
            <circle class="fill-amber" cx="74" cy="132" r="7" />
            <circle class="fill-blue" cx="96" cy="132" r="7" />
          </>
        </g>
      )
    }
    {
      slug === 'resulta' && (
        <g>
          <>
            <path d="M45 36h150v88H45zM70 62h48M70 82h76M70 102h38" />
            <path class="accent" d="m160 69 10 10 22-25" />
            <circle class="fill-green" cx="170" cy="79" r="27" />
          </>
        </g>
      )
    }
  </svg>
  <figcaption>{label}</figcaption>
</figure>
