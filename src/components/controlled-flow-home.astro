---
import { FlowStories } from './flow-stories';
import type { Locale } from '@/lib/portfolio-content';
import { portfolioContent } from '@/lib/portfolio-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = portfolioContent[locale];
const ids =
  locale === 'en'
    ? {
        work: 'work',
        principles: 'principles',
        about: 'about',
        writing: 'writing',
        contact: 'contact',
      }
    : {
        work: 'trabalhos',
        principles: 'principios',
        about: 'sobre',
        writing: 'artigos',
        contact: 'contato',
      };
---

<header class="cf-header">
  <a class="cf-brand" href={locale === 'en' ? '/en/' : '/'} aria-label="Gabriel Almir — home"
    ><img src="/brand-mark.svg" width="48" height="48" alt="" /><small>systems / flows</small></a
  >
  <nav aria-label="Primary navigation">
    {c.nav.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
  <a
    class="language-switch"
    href={c.alternateHref}
    hreflang={locale === 'en' ? 'pt-BR' : 'en'}
    lang={locale === 'en' ? 'pt-BR' : 'en'}>{c.alternateLabel}<span aria-hidden="true">↗</span></a
  >
</header>

<main id="main" class="controlled-flow">
  <section class="cf-hero" aria-labelledby="hero-title">
    <div class="flow-kicker"><span class="status-dot"></span>{c.hero.eyebrow}</div>
    <h1 id="hero-title">{c.hero.title}</h1>
    <p class="hero-copy">{c.hero.body}</p>
    <div class="hero-actions">
      <a class="primary-action" href={`#${ids.work}`}>{c.hero.primary}</a><a
        class="secondary-action"
        href={`#${ids.contact}`}>{c.hero.secondary}</a
      >
    </div>
    <div class="hero-line" aria-hidden="true"><span></span><i></i></div>
  </section>

  <section class="proof-strip" aria-labelledby="proof-title">
    <h2 id="proof-title" class="sr-only">{c.proofTitle}</h2>
    {
      c.proofs.map(([value, label, note]) => (
        <article>
          <>
            <strong>{value}</strong>
            <div>
              <>
                <h3>{label}</h3>
                <p>{note}</p>
              </>
            </div>
            <span class="verified">✓</span>
          </>
        </article>
      ))
    }
  </section>

  <section id={ids.work} class="cf-section work-section">
    <div class="section-heading">
      <p class="eyebrow">{c.workEyebrow}</p><h2>{c.workTitle}</h2><p>{c.workIntro}</p>
    </div>
    <FlowStories client:load stories={[...c.stories]} labels={c.stateLabels} />
    <noscript>
      <div class="static-stories">
        {
          c.stories.map((story) => (
            <article>
              <p class="eyebrow">
                {story.index} / {story.eyebrow}
              </p>
              <h3>{story.title}</h3>
              <p>{story.summary}</p>
              <dl>
                <div>
                  <>
                    <dt>{c.stateLabels[0]}</dt>
                    <dd>{story.constraint}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{c.stateLabels[1]}</dt>
                    <dd>{story.decision}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{c.stateLabels[2]}</dt>
                    <dd>{story.result}</dd>
                  </>
                </div>
              </dl>
              {story.href && (
                <a class="text-link" href={story.href}>
                  {story.hrefLabel}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </noscript>
  </section>

  <section id={ids.principles} class="cf-section principles-section">
    <div class="section-heading">
      <p class="eyebrow">{c.principles.eyebrow}</p><h2>{c.principles.title}</h2>
    </div>
    <div class="principles-grid">
      {
        c.principles.items.map(([number, title, body]) => (
          <article>
            <>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section id={ids.about} class="cf-section human-section">
    <div class="portrait-frame">
      <img
        src="/me.webp"
        width="640"
        height="640"
        loading="lazy"
        alt={locale === 'en' ? 'Portrait of Gabriel Almir' : 'Retrato de Gabriel Almir'}
      /><span>human / system</span>
    </div>
    <div>
      <p class="eyebrow">{c.about.eyebrow}</p><h2>{c.about.title}</h2><p class="large-copy">
        {c.about.body}
      </p><p>{c.about.note}</p>
    </div>
  </section>

  <section id={ids.writing} class="cf-section writing-section">
    <div class="section-heading">
      <p class="eyebrow">{c.writing.eyebrow}</p><h2>{c.writing.title}</h2><p>{c.writing.intro}</p>
    </div>
    <div class="writing-list">
      {
        c.writing.items.map(([title, meta, href], index) => (
          <a href={href}>
            <>
              <span>0{index + 1}</span>
              <h3>{title}</h3>
              <small>{meta}</small>
              <i aria-hidden="true">↗</i>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section id={ids.contact} class="contact-section">
    <p class="eyebrow">{c.contact.eyebrow}</p><h2>{c.contact.title}</h2><p>{c.contact.body}</p>
    <div class="hero-actions">
      <a class="primary-action" href="mailto:gabriel@gabrielalmir.com.br">{c.contact.email}</a><a
        class="secondary-action"
        href="https://linkedin.com/in/gabrielalmir"
        target="_blank"
        rel="noreferrer">{c.contact.linkedin}</a
      >
    </div>
  </section>
</main>

<footer class="cf-footer">
  <a class="cf-brand" href={locale === 'en' ? '/en/' : '/'}
    ><img src="/brand-mark.svg" width="48" height="48" alt="" /></a
  ><p>{c.footer}</p><p>© {new Date().getFullYear()} Gabriel Almir</p>
</footer>
