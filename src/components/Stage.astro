---
/**
 * O palco — o fundo contínuo da home.
 *
 * Fixo, em tela cheia, atrás de tudo. Três camadas: duas chapas de luz (a/b)
 * que fazem crossfade a cada troca de capítulo, e o canvas WebGL, que nasce
 * transparente e só é revelado por src/motion/stage.ts quando o gate libera a
 * cena. Chapa e cena são a mesma luz: uma parada, a outra em movimento.
 *
 * Só existe no modo capítulos (`html.motion-ready.chapters`, ≥768px). Fora
 * dele fica `display: none` — e cada seção já carrega a própria chapa como
 * fundo estático via `--plate`, então sem JS ninguém perde a atmosfera.
 *
 * As chapas são publicadas como `--plate-N` no :root, para as seções (que
 * referenciam `var(--plate-N)`) e para o motion, que escreve a mesma variável
 * nas camadas a/b. Elas são geradas, não desenhadas — ver src/lib/plates.ts.
 */
import { platesCss } from '../lib/plates';
---

{/* No :root, para as seções e o motion lerem a mesma URL. `is:inline` porque
    o valor vem do build e o Astro não interpola dentro de <style>. */}
<style is:inline set:html={platesCss()}></style>

<div
  data-stage
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 hidden bg-ink-900 md:block"
>
  <div data-stage-plate="a" class="stage-plate absolute inset-0" style="background-image: var(--plate-1)"></div>
  <div data-stage-plate="b" class="stage-plate absolute inset-0" style="background-image: var(--plate-1); opacity: 0"></div>
  <canvas data-stage-canvas class="absolute inset-0 h-full w-full" style="opacity: 0"></canvas>
  {/* O véu: escurece o palco onde o texto mora (à esquerda e no centro),
      para a tinta ser sentida atrás do parágrafo, não lida junto com ele. */}
  <div data-stage-scrim class="stage-scrim absolute inset-0"></div>
</div>
