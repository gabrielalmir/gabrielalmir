---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/lib/portfolio-content';
import SystemVisual from './SystemVisual.astro';
import AtlasIcon from './AtlasIcon';
const { locale, systems } = Astro.props as {
  locale: Locale;
  systems: CollectionEntry<'systems'>[];
};
const prefix = locale === 'en' ? '/en' : '';
const dossiers = systems.filter(({ data }) => data.tier === 'dossier');
const labs = systems.filter(({ data }) => data.tier === 'lab');
const publicSites: Record<string, string> = {
  maybe: 'https://gabrielalmir.github.io/maybe/',
  saturno: 'https://saturno.gabrielalmir.com.br/',
};
const en = locale === 'en';
const labels =
  locale === 'en'
    ? {
        eyebrow: '02 / systems atlas',
        title: 'Systems, decisions, and consequences.',
        intro:
          'Architectural plates grounded in public code: context, forces, decisions, consequences, evidence, and known limits.',
        dossiers: 'Architecture dossiers',
        labs: 'Technical laboratories',
        context: 'Context',
        decision: 'Decision',
        evidence: 'Evidence',
        limit: 'Known limit',
        open: 'Open dossier',
        inspect: 'Inspect laboratory',
      }
    : {
        eyebrow: '02 / atlas de sistemas',
        title: 'Sistemas, decisões e consequências.',
        intro:
          'Placas arquiteturais sustentadas por código público: contexto, forças, decisões, consequências, evidências e limites conhecidos.',
        dossiers: 'Dossiês de arquitetura',
        labs: 'Laboratórios técnicos',
        context: 'Contexto',
        decision: 'Decisão',
        evidence: 'Evidência',
        limit: 'Limite conhecido',
        open: 'Abrir dossiê',
        inspect: 'Inspecionar laboratório',
      };
---

<section
  class="section systems-atlas"
  id={locale === 'en' ? 'systems' : 'sistemas'}
  data-build-section="systems"
  aria-labelledby="systems-title"
>
  <div class="atlas-heading" data-build-item>
    <header class="section-head">
      <p class="kicker">{labels.eyebrow}</p>
      <h2 id="systems-title">{labels.title}</h2>
      <p>{labels.intro}</p>
    </header>
    <figure class="atlas-editorial">
      <img
        src="/images/editorial/systems-atlas.webp"
        width="1600"
        height="533"
        loading="lazy"
        alt=""
      />
      <figcaption>
        {en ? 'system / boundary / evidence' : 'sistema / fronteira / evidência'}
      </figcaption>
    </figure>
  </div>
  <div class="atlas-group-heading">
    <h3 class="atlas-group-title">{labels.dossiers}</h3>
    <p>{en ? 'Three systems examined in depth.' : 'Três sistemas examinados em profundidade.'}</p>
  </div>
  <div class="dossier-grid">
    {
      dossiers.map(({ data }, index) => (
        <article class="system-plate" data-build-item>
          <header>
            <p class="project-index">0{index + 1}</p>
            <div>
              <p class="kicker">{data.eyebrow}</p>
              <h3>{data.title}</h3>
            </div>
            <span class={`system-status status-${data.status}`}>{data.status}</span>
          </header>
          <SystemVisual
            slug={data.slug}
            label={`${en ? 'Visual summary of' : 'Resumo visual de'} ${data.title}`}
          />
          <p class="system-summary">{data.card?.summary ?? data.summary}</p>
          <div class="project-decision">
            <AtlasIcon name="branch" size={22} strokeWidth={1.8} />
            <div>
              <small>{labels.decision}</small>
              <p>{data.card?.decision ?? data.decisions[0].body}</p>
            </div>
          </div>
          <p class="project-evidence">
            <AtlasIcon name="check" size={18} strokeWidth={2} />
            {data.card?.evidence ?? data.evidence[0].detail}
          </p>
          <div class="system-links">
            <a class="text-link" href={`${prefix}/projects/${data.slug}`}>
              {labels.open} <span>→</span>
            </a>
            {publicSites[data.slug] && (
              <a
                class="text-link"
                href={publicSites[data.slug]}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${en ? 'Open public demonstration' : 'Abrir demonstração pública'} — ${data.title} (${en ? 'external site' : 'site externo'})`}
              >
                {en ? 'Public demo' : 'Demonstração pública'} ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
  <div class="atlas-group-heading labs-title">
    <h3 class="atlas-group-title">{labels.labs}</h3>
    <p>
      {
        en
          ? 'Focused experiments with explicit boundaries.'
          : 'Experimentos focados, com limites explícitos.'
      }
    </p>
  </div>
  <div class="lab-grid">
    {
      labs.map(({ data }, index) => (
        <article class="lab-card" data-build-item>
          <header>
            <div>
              <p class="project-index">L0{index + 1}</p>
              <p class="kicker">{data.status}</p>
            </div>
            <SystemVisual
              slug={data.slug}
              label={`${en ? 'Symbol for' : 'Símbolo de'} ${data.title}`}
              compact
            />
          </header>
          <h3>{data.title}</h3>
          <p class="lab-summary">{data.summary}</p>
          <p class="lab-limit">
            <AtlasIcon name="warning" size={18} strokeWidth={2} />
            {data.limits[0]}
          </p>
          <a class="text-link" href={`${prefix}/projects/${data.slug}`}>
            {labels.inspect} <span>→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>

<aside class="open-source-support" aria-labelledby="support-title" data-build-section="support">
  <div data-build-item>
    <p class="kicker">open source / continuity</p><h2 id="support-title">
      {
        locale === 'en'
          ? 'Help keep this open-source work moving.'
          : 'Ajude este trabalho aberto a continuar.'
      }
    </h2><p>
      {
        locale === 'en'
          ? 'Research, maintenance, documentation, and infrastructure take time. If this work is useful to you, a coffee helps support the next decisions, fixes, and releases.'
          : 'Pesquisa, manutenção, documentação e infraestrutura exigem tempo. Se algum destes projetos é útil para você, um café ajuda a manter as próximas decisões, correções e versões.'
      }
    </p>
  </div>
  <a
    class="button"
    href="https://ko-fi.com/gabrielalmir"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={locale === 'en'
      ? 'Support on Ko-fi (opens an external service)'
      : 'Apoiar no Ko-fi (abre um serviço externo)'}
    >{locale === 'en' ? 'Support on Ko-fi ↗' : 'Apoiar no Ko-fi ↗'}</a
  >
</aside>
