---
/**
 * Barra diagonal — separa rótulos (kicker, metadados de dossiê, links do rodapé).
 *
 * Marca pequena, então a proporção importa mais que o gesto: comprimento longo
 * contra espessura curta, com a barriga só no meio. A respiga do fim continua o
 * movimento depois que a tinta acabou, e por isso sai da linha do corpo.
 */
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label } = Astro.props;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 26 44"
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
>
  <path
    data-mark-draw
    stroke-width="1.8"
    d="M19.8 4C17.4 12.6 13.6 22 9 31.8C7.9 34.1 6.8 36.2 5.7 38.2"
  ></path>
  <path data-mark-draw stroke-width="3" d="M17.6 11.4C15.2 17.6 12.6 23.6 9.8 29.4"></path>
  <path data-mark-draw stroke-width="0.9" d="M6.6 34.8C5.6 36.8 4.8 38.6 4.2 40.2"></path>
</svg>
