---
/**
 * Respingo — marca o "agora" na trajetória (data-trajectory-now) e o estado de
 * alerta dos nós `risk` do mapa. É a única marca vermelha do site: no máximo
 * uma por viewport.
 *
 * Exceção às outras marcas: respingo é massa, não gesto. Vai em `fill` e leva
 * `data-reveal` (aparece de uma vez, como tinta que bate no papel) em vez de
 * `data-mark-draw`, que só faz sentido para contorno em stroke-dashoffset.
 *
 * A gota cai inclinada, e é isso que a geometria conta: a massa (primeiro path)
 * tem uma faceta reta embaixo à esquerda, onde escorregou; as quatro farpas
 * seguintes têm comprimentos desiguais e saem presas a ela pela base; os
 * satélites seguem o mesmo eixo, alongados perto e mais redondos longe. Massa
 * redonda com espinhos iguais em volta viraria estrela de ícone, não impacto.
 */
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label } = Astro.props;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
