---
/**
 * Traço horizontal de nanquim — vai sob os números de prova (Proofs.astro).
 *
 * A espessura é a *união* de traços encaixados, não a largura de um path só:
 * ataque fino, corpo, meio, barriga, e a ponta que volta a afinar. Um único
 * path daria espessura constante — ou seja, ícone, não tinta. A cerda de saída
 * é o pelo que escapa do pincel no arremate e por isso desce fora da linha.
 *
 * `preserveAspectRatio="none"` porque o traço acompanha numerais de larguras
 * diferentes; sem altura imposta pelo consumidor, a proporção do viewBox vale.
 */
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label } = Astro.props;

// Mesma regra do Icon.astro: sem rótulo a marca é decoração e sai da árvore.
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 720 32"
  preserveAspectRatio="none"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
>
  <path data-mark-draw stroke-width="2.8" d="M9 20.4C24 18.6 42 16.9 62 15.4"></path>
  <path
    data-mark-draw
    stroke-width="5.2"
    d="M40 17.6C142 11.9 244 9.4 344 10.1C444 10.8 546 14.6 646 19.2"
  ></path>
  <path
    data-mark-draw
    stroke-width="8.2"
    d="M74 15.1C160 11.2 246 9.5 330 10C382 10.3 434 11.4 486 13.1"
  ></path>
  <path
    data-mark-draw
    stroke-width="11"
    d="M104 13.4C176 10.8 248 9.8 318 10.3C344 10.5 368 10.9 390 11.5"
  ></path>
  <path data-mark-draw stroke-width="2.6" d="M618 18C650 19.9 678 20.6 710 18.6"></path>
  <path data-mark-draw stroke-width="1.4" d="M596 18.6C634 20.9 666 22.6 700 23.2"></path>
</svg>
