---
/**
 * Mapa arquitetural de um sistema.
 *
 * Uma implementação só, duas orientações. A natureza de um nó — fronteira,
 * decisão, evidência, risco — é vocabulário do site inteiro; se cada tela
 * desenhasse o seu, o dia em que `risk` mudasse de cor seria o dia em que os
 * dois mapas passariam a discordar em silêncio.
 *
 *  - `vertical` (padrão): trilho em coluna, com a nota de cada nó. É a forma
 *    do dossê, onde há largura de leitura e tempo para a nota.
 *  - `horizontal`: faixa de caixas lado a lado, sem nota. É a forma do painel
 *    da home, onde o mapa é um resumo de relance dentro de uma faixa larga.
 *
 * SVG não reflui texto, então toda quebra é calculada no build e a altura do
 * viewBox sai do resultado — assim um mapa de 2 nós e um de 4 nunca colidem.
 *
 * O SVG é `aria-hidden`: quem usa leitor de tela recebe a lista antes dele,
 * onde a natureza do nó vira palavra em vez de cor e forma.
 */
interface Props {
  nodes: { label: string; kind: 'boundary' | 'decision' | 'evidence' | 'risk'; note: string }[];
  /** Controla a largura renderizada — e, com ela, a escala do texto do SVG. */
  class?: string;
  title: string;
  orientation?: 'vertical' | 'horizontal';
}

const {
  nodes,
  class: className,
  title,
  orientation = 'vertical',
} = Astro.props;

const horizontal = orientation === 'horizontal';

type Kind = Props['nodes'][number]['kind'];

/**
 * Cor e forma por natureza de nó — a única tabela do site que decide isso.
 * `mark` pinta a forma do trilho vertical, `box` a caixa da faixa horizontal,
 * e `label` o texto: para tipo pequeno o azul estrutural cede lugar ao
 * blue-bright, como manda a regra de contraste da paleta.
 */
const KIND: Record<Kind, { name: string; mark: string; label: string; box: string; dash?: string }> =
  {
    boundary: {
      name: 'fronteira',
      mark: 'text-blue',
      label: 'fill-blue-bright',
      box: 'stroke-blue',
    },
    decision: { name: 'decisão', mark: 'text-paper', label: 'fill-paper', box: 'stroke-paper/55' },
    evidence: {
      name: 'evidência',
      mark: 'text-blue-wash',
      label: 'fill-blue-wash',
      box: 'stroke-blue-wash',
    },
    // Tracejado: o limite conhecido é a única aresta do mapa que não fecha.
    risk: {
      name: 'risco',
      mark: 'text-red',
      label: 'fill-red-bright',
      box: 'stroke-red',
      dash: '5 4',
    },
  };

/** Quebra um texto em linhas de no máximo `maxChars`, sem hifenizar. */
function wrap(text: string, maxChars: number): string[] {
  const lines: string[] = [];
  let line = '';
  for (const word of text.split(/\s+/)) {
    const next = line ? `${line} ${word}` : word;
    if (line && next.length > maxChars) {
      lines.push(line);
      line = word;
    } else {
      line = next;
    }
  }
  if (line) lines.push(line);
  return lines;
}

// ---------------------------------------------------------------------------
// Vertical — unidades do viewBox. A largura é pequena de propósito: quanto mais
// perto de 1:1 for a escala no menor telefone, mais previsível fica o texto.
// ---------------------------------------------------------------------------
const V_WIDTH = 260;
const RAIL_X = 20;
const TEXT_X = 46;
const NOTE_LEAD = 14;
const NOTE_CHARS = 34;

let cursor = 16;
const laid = horizontal
  ? []
  : nodes.map((node) => {
      const noteLines = wrap(node.note, NOTE_CHARS);
      const placed = { ...node, cy: cursor, noteLines };
      cursor += 22 + (noteLines.length - 1) * NOTE_LEAD + 30;
      return placed;
    });
const vHeight = Math.round(cursor - 16);

// Um traço por ligação, com uma curvatura mínima: linha reta de régua destoaria
// do resto do desenho, que é feito à mão.
const links = laid.slice(1).map((node, index) => {
  const from = laid[index]!.cy + 11;
  const to = node.cy - 11;
  const bend = (to - from) * 0.35;
  return `M ${RAIL_X} ${from} C ${RAIL_X - 3} ${from + bend} ${RAIL_X + 3} ${to - bend} ${RAIL_X} ${to}`;
});

// ---------------------------------------------------------------------------
// Horizontal — 720x120 é o que cabe na coluna de um painel da home. Abaixo
// disso o <text> encolheria junto com o viewBox e viraria ilegível, então o SVG
// tem largura mínima e rola dentro da própria caixa em tela estreita: nunca
// empurra a página.
// ---------------------------------------------------------------------------
const H_WIDTH = 720;
const H_HEIGHT = 120;
const BOX_HEIGHT = 56;
const BOX_TOP = 30;
const BOX_GAP = 32;
const BOX_MIDDLE = BOX_TOP + BOX_HEIGHT / 2;
const LABEL_SIZE = 12;
const LINE_STEP = 15;

// Cinco caixas na faixa deixariam cada uma com menos de 12 caracteres úteis,
// que é menos que o menor rótulo do conteúdo atual. Quando um mapa passar
// disso, a faixa deixa de ser a forma certa — o corte é explícito para que a
// perda apareça na revisão em vez de sumir no desenho.
const H_MAX_NODES = 4;
const dropped = horizontal ? Math.max(0, nodes.length - H_MAX_NODES) : 0;

const band = (horizontal ? nodes.slice(0, H_MAX_NODES) : []).map((node, index, all) => {
  const width = (H_WIDTH - BOX_GAP * (all.length - 1)) / all.length;
  // 0.62em é o avanço médio do Geist Mono; 20 é o respiro lateral da caixa.
  const maxChars = Math.floor((width - 20) / (LABEL_SIZE * 0.62));
  const lines = wrap(node.label, maxChars);
  return {
    ...node,
    x: index * (width + BOX_GAP),
    width,
    // Rótulo muito longo perde a quebra fina, mas não estoura a caixa em altura.
    lines: lines.length <= 2 ? lines : [lines[0]!, lines.slice(1).join(' ')],
  };
});
---

<figure class:list={['w-full', className ?? (horizontal ? '' : 'max-w-[22rem]')]}>
  <figcaption class="sr-only">{title}</figcaption>

  <ol class="sr-only">
    {
      nodes.map((node) => (
        <li>
          {node.label} — {KIND[node.kind].name}. {node.note}
        </li>
      ))
    }
  </ol>

  {
    dropped > 0 && (
      <p class="u-label text-ink-400">
        A faixa mostra os {H_MAX_NODES} primeiros nós; o mapa completo está no dossiê.
      </p>
    )
  }

  {
    horizontal ? (
      /* `tabindex` existe para que o teclado alcance o rolo lateral da faixa —
         e um contêiner focável precisa de nome, senão o leitor de tela anuncia
         uma parada em branco. `title` já nomeia a figura. */
      <div class="overflow-x-auto pb-1" tabindex="0" role="group" aria-label={title}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox={`0 0 ${H_WIDTH} ${H_HEIGHT}`}
          fill="none"
          class="h-auto w-full max-w-[45rem] min-w-[40rem]"
          aria-hidden="true"
        >
          {band.slice(0, -1).map((node, index) => {
            const from = node.x + node.width;
            const to = band[index + 1]!.x;
            return (
              <path
                data-map-line
                d={`M ${from} ${BOX_MIDDLE} C ${from + 11} ${BOX_MIDDLE - 5} ${to - 11} ${BOX_MIDDLE + 5} ${to} ${BOX_MIDDLE}`}
                class="stroke-blue"
                stroke-width="1.25"
                stroke-linecap="round"
              />
            );
          })}

          {band.map((node) => (
            <g>
              <rect
                x={node.x}
                y={BOX_TOP}
                width={node.width}
                height={BOX_HEIGHT}
                rx="1"
                class={KIND[node.kind].box}
                stroke-width="1"
                stroke-dasharray={KIND[node.kind].dash}
              />
              {node.lines.map((line, li) => (
                <text
                  x={node.x + node.width / 2}
                  y={BOX_MIDDLE + (li - (node.lines.length - 1) / 2) * LINE_STEP}
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-size={LABEL_SIZE}
                  letter-spacing="0.04em"
                  class:list={['font-mono', KIND[node.kind].label]}
                >
                  {line}
                </text>
              ))}
            </g>
          ))}
        </svg>
      </div>
    ) : (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox={`0 0 ${V_WIDTH} ${vHeight}`}
        width={V_WIDTH}
        height={vHeight}
        class="h-auto w-full"
        aria-hidden="true"
      >
        {links.map((d) => (
          <path
            d={d}
            data-map-line
            fill="none"
            stroke-width="1.25"
            stroke-linecap="round"
            class="stroke-ink-500"
          />
        ))}

        {laid.map((node) => (
          <g class={KIND[node.kind].mark}>
            {node.kind === 'boundary' && (
              <rect
                x={RAIL_X - 6.5}
                y={node.cy - 6.5}
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              />
            )}
            {node.kind === 'decision' && <circle cx={RAIL_X} cy={node.cy} r="6" fill="currentColor" />}
            {node.kind === 'evidence' && (
              <>
                <circle
                  cx={RAIL_X}
                  cy={node.cy}
                  r="6.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle cx={RAIL_X} cy={node.cy} r="2" fill="currentColor" />
              </>
            )}
            {node.kind === 'risk' && (
              <path
                d={`M ${RAIL_X} ${node.cy - 8} L ${RAIL_X + 8} ${node.cy} L ${RAIL_X} ${node.cy + 8} L ${RAIL_X - 8} ${node.cy} Z`}
                fill="currentColor"
              />
            )}

            <text
              x={TEXT_X}
              y={node.cy + 5}
              font-size="14.5"
              letter-spacing="0.01em"
              class:list={['font-mono', KIND[node.kind].label]}
            >
              {node.label}
            </text>

            {node.noteLines.map((line, index) => (
              <text
                x={TEXT_X}
                y={node.cy + 22 + index * NOTE_LEAD}
                font-size="11"
                class="fill-ink-300 font-sans"
              >
                {line}
              </text>
            ))}
          </g>
        ))}
      </svg>
    )
  }
</figure>
