---
interface Props {
  direction?: 'up' | 'right' | 'left';
  class?: string;
}
const { direction = 'right', class: className } = Astro.props;
---

<svg
  class:list={['arrow', className, `arrow-${direction}`]}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path d="M4 12h15m-6-6 6 6-6 6" />
</svg>
