---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { hero, trajectory } from '../lib/content';
import { figureImages } from '../lib/images';
const current = trajectory.career.find((entry) => 'now' in entry && entry.now)!;
---

<section id="inicio" class="hero shell" aria-labelledby="hero-title">
  <div class="hero-top label">
    <span>{hero.kicker}</span>
    <span class="edition">Portfólio / 2026</span>
  </div>
  <div class="hero-copy">
    <h1 id="hero-title">
      {hero.title}
      <span class="name-dot" aria-hidden="true">
        .
      </span>
    </h1>
    <p class="hero-heading">
      {hero.headline} <span>{hero.focus}</span>
    </p>
    <div class="hero-actions">
      {hero.actions.map((action) => (
        <a
          class:list={['button', action.primary ? 'button-primary' : 'button-text']}
          href={action.href}
        >
          {action.label}
          {action.primary && <Arrow />}
        </a>
      ))}
    </div>
  </div>
  <div class="hero-grid">
    <div class="hero-intro">
      <p class="label">01 / Apresentação</p>
      <p class="hero-lead">{hero.lead}</p>
    </div>
    <figure class="portrait-figure">
      <div class="portrait-frame">
        <div class="portrait-paper">
          <Image
            src={figureImages.portrait}
            alt="Retrato ilustrado de Gabriel Almir a grafite, de frente, com moletom."
            widths={[288, 320, 420, 640, 840]}
            sizes="(min-width: 768px) 420px, (min-width: 408px) 320px, calc(100vw - 88px)"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <figcaption class="label">Retrato ilustrado a partir de fotografia</figcaption>
    </figure>
    <div class="hero-professional">
      <p class="label">Atuação atual</p>
      <strong>{current.role}</strong>
      <p>
        {current.org}
        <br />
        {current.period}
      </p>
      <a class="text-link" href="#trajetoria">
        Conhecer a trajetória <Arrow />
      </a>
    </div>
  </div>
  <div class="hero-bottom">
    <p class="status">
      <span aria-hidden="true"></span>
      {hero.status}
    </p>
    <a href="#sistemas">
      Projetos selecionados <span class="sr-only">— ir ao MCP AnimagineXL</span>
    </a>
  </div>
</section>
