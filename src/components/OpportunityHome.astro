---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Arrow from './Arrow.astro';
import Learning from './Learning.astro';
import ProjectStructure from './ProjectStructure.astro';
import {
  contact,
  hero,
  trajectory,
  aboutSection,
  projectReadings,
  systemsSection,
} from '../lib/content';
import { figureImages } from '../lib/images';
const entries = await getCollection('systems');
const career = [...trajectory.career].reverse();
const featured = systemsSection.featured.map((id) => entries.find((entry) => entry.id === id)!);
const technologies = {
  'mcp-animaginexl': 'Python · MCP · Diffusers',
  pimbas: 'TypeScript · Next.js · Domínio',
  maybe: 'PHP 7.4 · Schema · DTO',
};
---

<div class="opportunity-home">
  <section id="inicio" class="intro shell" aria-labelledby="hero-title">
    <div class="intro-content">
      <p class="eyebrow">Analista de Sistemas Pleno</p>
      <h1 id="hero-title">
        Gabriel Almir<span aria-hidden="true">.</span>
      </h1>
      <p class="headline">
        Backend e<br />
        integrações.<span>Explorando IA aplicada.</span>
      </p>
      <p class="intro-summary">
        Conecto sistemas, desenvolvo APIs e evoluo aplicações corporativas. Nos projetos pessoais,
        exploro a integração de agentes e modelos de IA.
      </p>
      <p class="availability">
        <span aria-hidden="true"></span>
        {hero.status}
      </p>
      <div class="actions">
        <a class="button button-primary" href={`mailto:${contact.email}`}>
          Entrar em contato <Arrow direction="up" />
        </a>
        <a class="text-link" href="#sistemas">
          Ver projetos <Arrow />
        </a>
        <a class="text-link mobile-linkedin" href={contact.linkedin}>
          LinkedIn <Arrow direction="up" />
        </a>
      </div>
    </div>
    <figure class="profile">
      <div class="profile-art">
        <Image
          src={figureImages.portrait}
          alt="Retrato ilustrado de Gabriel Almir a grafite, de frente, com moletom."
          widths={[240, 400, 640]}
          sizes="(max-width: 767px) 72px, (max-width: 1000px) 240px, 320px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span class="profile-caption-line" aria-hidden="true"></span>
        <div>
          <strong>Itapira, São Paulo</strong>
          <a class="profile-link" href={contact.linkedin}>
            LinkedIn <Arrow direction="up" />
          </a>
        </div>
      </figcaption>
    </figure>
    <div class="skills" aria-label="Áreas e tecnologias">
      <span>Node.js / TypeScript</span>
      <span>Python</span>
      <span>APIs & integrações ERP</span>
      <span>Sistemas legados</span>
      <span>Docker</span>
    </div>
  </section>

  <section id="trajetoria" class="resume-section shell" aria-labelledby="experience-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Experiência</p>
        <h2 id="experience-title">Experiência profissional.</h2>
      </div>
      <a class="text-link" href={contact.linkedin}>
        Perfil completo <Arrow direction="up" />
      </a>
    </div>
    <div class="experience-layout">
      <aside id="provas" class="result" aria-label="Resultado profissional na CTC">
        <p class="eyebrow">Resultado em destaque</p>
        <p class="result-number">−90%</p>
        <h3>no tempo de carregamento</h3>
        <p>Redução no carregamento de um sistema crítico na CTC.</p>
        <small>Relato profissional anonimizado; única métrica autorizada para publicação.</small>
      </aside>
      <div class="jobs">
        {career.slice(0, 2).map((job) => (
          <article class="job">
            <div class="job-top">
              <h3>{job.org}</h3>
              {'now' in job && <span class="badge">Atual</span>}
            </div>
            <p class="job-role">{job.role}</p>
            <p class="period">{job.period}</p>
            <p>{job.summary}</p>
          </article>
        ))}
        <details class="more">
          <summary>Experiências anteriores · 2013–2023</summary>
          {career.slice(2).map((job) => (
            <article class="job">
              <h3>{job.org}</h3>
              <p class="job-role">{job.role}</p>
              <p class="period">{job.period}</p>
              <p>{job.summary}</p>
            </article>
          ))}
        </details>
      </div>
    </div>
  </section>

  <section id="sistemas" class="projects-section" aria-labelledby="projects-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Projetos selecionados</p>
          <h2 id="projects-title">Sistemas e decisões.</h2>
        </div>
        <p>
          Projetos pessoais que mostram
          <br />
          como organizo e integro sistemas.
        </p>
      </div>
      <div class="project-grid">
        {featured.map((entry, index) => {
          const id = entry.id as keyof typeof projectReadings;
          return (
            <article class="project-card">
              <div class="project-meta">
                <span>0{index + 1}</span>
                <span>
                  {entry.data.status === 'experimental' ? 'Experimental' : 'Implementado'}
                </span>
              </div>
              <h3>{entry.data.title}</h3>
              <p class="project-tech">{technologies[id]}</p>
              <ProjectStructure slug={id} />
              <p>{projectReadings[id].problem}</p>
              <p class="project-outcome">
                <strong>Decisão técnica</strong>
                <br />
                {entry.data.decisions[0].body}
              </p>
              <small>{projectReadings[id].limit}</small>
              <a
                class="text-link"
                href={`/projects/${id}`}
                aria-label={`Ler estudo de caso: ${entry.data.title}`}
              >
                Ler estudo de caso <Arrow />
              </a>
            </article>
          );
        })}
      </div>
      <div class="other-projects">
        <span>Outros projetos</span>
        {systemsSection.complementary.map((id) => (
          <a class="text-link" href={`/projects/${id}`}>
            {entries.find((entry) => entry.id === id)!.data.title}
            <Arrow direction="up" />
          </a>
        ))}
      </div>
      <div id="ia" class="ai-note">
        <h3>Próximo passo: IA aplicada</h3>
        <p>
          Aplico minha base em backend à integração de agentes e modelos no MCP AnimagineXL. A
          experiência profissional é em sistemas corporativos; os projetos de IA são experimentais.
          Avaliação, observabilidade e operação de modelos seguem como estudos.
        </p>
      </div>
    </div>
  </section>

  <section id="sobre" class="resume-section shell about" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">03 / Sobre mim</p>
      <h2 id="about-title">Além do trabalho.</h2>
      <p>{aboutSection.body}</p>
      <p class="community">
        Tenho curiosidade por compiladores, interfaces de terminal e astronomia — interesses que
        acompanham minha forma de explorar tecnologia.
      </p>
      <p class="community">
        No PhotoGIMP, projeto comunitário da Diolinux, contribuí na evolução e hoje participo da
        organização de issues e da revisão.
      </p>
      <div class="social-links">
        {trajectory.publicPresence.map((item) => (
          <a class="text-link" href={item.href}>
            {item.org}
            <Arrow direction="up" />
          </a>
        ))}
      </div>
    </div>
    <div class="education">
      <h3>Formação</h3>
      {[...trajectory.formation.slice(0, 2)].reverse().map((item) => (
        <article>
          <h4>{item.org}</h4>
          <p>{item.role}</p>
          <p class="period">{item.period}</p>
        </article>
      ))}
      <details class="more">
        <summary>Competições de programação</summary>
        <p>{trajectory.note}</p>
        <ul>
          {trajectory.formation.slice(2).map((item) => (
            <li>
              {item.org} · {item.period}
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>
  <Learning />
  <section id="processo" class="working-method shell" aria-labelledby="method-title">
    <div>
      <p class="eyebrow">Como trabalho</p>
      <h2 id="method-title">Decisões que ficam claras.</h2>
    </div>
    <ol>
      <li>
        <span>01</span>
        <strong>Entender</strong>
        <p>Investigar o fluxo, as dependências e as restrições.</p>
      </li>
      <li>
        <span>02</span>
        <strong>Decidir</strong>
        <p>Explicitar escolhas e os motivos de cada uma.</p>
      </li>
      <li>
        <span>03</span>
        <strong>Verificar</strong>
        <p>Testar o comportamento e comparar evidências.</p>
      </li>
      <li>
        <span>04</span>
        <strong>Compartilhar</strong>
        <p>Documentar para facilitar a continuidade do trabalho.</p>
      </li>
    </ol>
  </section>
</div>
<style>
  .mobile-linkedin {
    display: none;
  }
  @media (max-width: 767px) {
    .mobile-linkedin {
      display: inline-flex;
    }
  }
  .community {
    margin-top: 14px;
  }
  .working-method {
    padding-bottom: 56px;
  }
  .working-method h2 {
    font-size: 28px;
  }
  .working-method ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 28px;
  }
  .working-method li {
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .working-method li span {
    color: var(--accent);
    font-size: 12px;
    margin-right: 12px;
  }
  .working-method li strong {
    font-size: 14px;
  }
  .working-method li p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 8px;
  }
  @media (max-width: 767px) {
    .working-method ol {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }
  .opportunity-home {
    position: relative;
    isolation: isolate;
    --section-gap: 72px;
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 36px 80px;
    padding-block: 56px 24px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    font-size: 23px;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin: 20px 0 24px;
    font-weight: 550;
  }
  h1 span {
    color: var(--accent);
  }
  .headline {
    font-size: clamp(48px, 5.5vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.06em;
    font-weight: 600;
  }
  .headline > span {
    display: block;
    color: var(--accent);
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 450;
    letter-spacing: -0.035em;
    line-height: 1.3;
    margin-top: 18px;
  }
  .intro-summary {
    max-width: 49ch;
    color: var(--muted);
    margin-top: 20px;
  }
  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    margin-top: 20px;
  }
  .availability span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 24px;
  }
  .profile {
    align-self: center;
    position: relative;
    padding: 0;
  }
  .profile-art {
    position: relative;
    isolation: isolate;
  }
  .profile img {
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: var(--portrait-paper);
    filter: var(--portrait-filter);
  }
  .profile figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    line-height: 1.6;
  }
  .profile-caption-line {
    width: 24px;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .profile strong {
    color: var(--ink);
    font-size: 13px;
    font-weight: 550;
  }
  .profile-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 12px;
    margin-top: 6px;
  }
  .profile-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .skills {
    grid-column: 1/-1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    border-block: 1px solid var(--line);
    padding: 20px 0;
    color: var(--muted);
    font-size: 13px;
  }
  .resume-section {
    padding-block: var(--section-gap);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }
  h2 {
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin-top: 12px;
  }
  .section-heading > p {
    color: var(--muted);
    font-size: 14px;
  }
  .experience-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .result {
    background: var(--wash);
    border-top: 3px solid var(--accent);
    padding: 28px;
    align-self: start;
  }
  .result-number {
    font-size: clamp(56px, 6vw, 80px);
    letter-spacing: -0.07em;
    line-height: 1.2;
    color: var(--accent);
    margin: 24px 0 8px;
  }
  h3 {
    font-size: 20px;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .result > p:not(.eyebrow):not(.result-number) {
    margin: 16px 0;
    font-size: 14px;
  }
  small {
    display: block;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.65;
  }
  .job {
    padding-bottom: 24px;
  }
  .job + .job {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .job-top {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }
  .badge {
    background: var(--wash);
    color: var(--accent);
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 4px;
  }
  .job-role {
    margin-top: 6px;
    font-weight: 500;
    font-size: 15px;
  }
  .period {
    font-family: var(--mono);
    color: var(--muted);
    font-size: 12px;
    margin: 4px 0 12px;
  }
  .job > p:last-child {
    color: var(--muted);
    font-size: 14px;
  }
  .more {
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  summary {
    cursor: pointer;
    padding: 18px 0;
    font-weight: 500;
  }
  .projects-section {
    background: color-mix(in srgb, var(--work) 75%, transparent);
    padding-block: var(--section-gap);
    border-block: 1px solid var(--line);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 3px;
  }
  .project-meta {
    font-family: var(--mono);
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 30px;
  }
  .project-card h3 {
    font-size: 24px;
  }
  .project-tech {
    font-size: 12px;
    color: var(--accent);
    margin: 10px 0 20px;
  }
  .project-card > p:not(.project-tech) {
    font-size: 14px;
    color: var(--muted);
  }
  .project-outcome {
    margin: 14px 0;
  }
  .project-card small {
    margin-bottom: 24px;
  }
  .project-card a {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .other-projects {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 28px;
    font-size: 13px;
    margin-top: 24px;
  }
  .other-projects > span {
    color: var(--muted);
  }
  .ai-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .ai-note p {
    font-size: 14px;
    color: var(--muted);
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .about h2 {
    margin-bottom: 20px;
  }
  .about p {
    color: var(--muted);
    font-size: 14px;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
  }
  .education article {
    margin-top: 20px;
  }
  .education h4 {
    font-size: 15px;
  }
  .education ul {
    margin: 16px 0;
    line-height: 1.8;
    font-size: 13px;
  }
  @media (max-width: 1000px) {
    .intro {
      gap: 32px;
      grid-template-columns: minmax(0, 1fr) 240px;
    }
    .experience-layout {
      gap: 32px;
    }
    .project-grid {
      gap: 12px;
    }
    .project-card {
      padding: 20px;
    }
    .about {
      gap: 40px;
    }
  }
  @media (max-width: 767px) {
    .opportunity-home {
      --section-gap: 44px;
    }
    .intro {
      position: relative;
      display: block;
      padding-top: 28px;
      padding-bottom: 0;
    }
    .intro .eyebrow {
      max-width: calc(100% - 92px);
      font-size: 10px;
      min-height: 28px;
      padding-top: 8px;
    }
    .intro .eyebrow span {
      display: block;
    }
    h1 {
      font-size: 22px;
      margin: 8px 0 32px;
    }
    .headline {
      font-size: clamp(44px, 11vw, 64px);
    }
    .headline > span {
      font-size: 22px;
      margin-top: 14px;
    }
    .intro-summary {
      font-size: 14px;
      margin-top: 16px;
    }
    .availability {
      font-size: 12px;
      margin-top: 16px;
    }
    .actions {
      gap: 16px 24px;
      margin-top: 20px;
      font-size: 13px;
    }
    .actions .button {
      width: 100%;
      justify-content: center;
    }
    .profile {
      position: absolute;
      top: 28px;
      right: 0;
      width: 72px;
      padding: 0;
    }
    .profile img {
      width: 72px;
      border-radius: 3px;
    }
    .profile figcaption {
      display: none;
    }
    .skills {
      gap: 10px 18px;
      margin-top: 28px;
      padding: 16px 0;
      font-size: 11px;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }
    .experience-layout,
    .project-grid,
    .about,
    .ai-note {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .result {
      padding: 20px;
    }
    .result-number {
      margin: 12px 0 4px;
      font-size: 56px;
    }
    .project-meta {
      font-family: var(--mono);
      margin-bottom: 20px;
    }
    .project-card {
      padding: 24px;
    }
    .other-projects {
      gap: 16px 22px;
    }
    .other-projects > span {
      width: 100%;
    }
    .ai-note {
      margin-top: 28px;
      gap: 12px;
    }
  }
</style>
