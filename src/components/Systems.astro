---
import type { CollectionEntry } from 'astro:content';
import { systemsSection, projectReadings } from '../lib/content';
import Arrow from './Arrow.astro';
import PimbasComparison from './PimbasComparison.astro';
interface Props {
  entries: CollectionEntry<'systems'>[];
}
const { entries } = Astro.props;
const find = (id: string) => entries.find((entry) => entry.id === id)!;
const pimbas = find('pimbas');
const maybe = find('maybe');
const complementary = systemsSection.complementary.map(find);
---

<section id="projetos-backend" class="work-section section" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-heading work-heading">
      <h2 id="work-title">
        Arquitetura que sustenta integrações
        <span class="section-count" aria-hidden="true">
          02
        </span>
      </h2>
      <p class="lead">
        Evolução de aplicações e contratos explícitos: competências de backend que aplico à
        integração de sistemas de IA.
      </p>
    </div>

    <article class="project-study study-pimbas" aria-labelledby="pimbas-title">
      <div class="study-intro">
        <p class="project-category">{pimbas.data.category}</p>
        <h3 id="pimbas-title">
          <a href={`/projects/${pimbas.id}`}>{pimbas.data.title}</a>
        </h3>
        <p class="study-question">{projectReadings.pimbas.question}</p>
        <p class="study-problem">{projectReadings.pimbas.problem}</p>
        <p class="study-implementation">{projectReadings.pimbas.outcome}</p>
        <p class="study-implementation">
          Em integrações com IA, essa separação permite evoluir a entrega sem acoplar as regras ao
          serviço de modelo.
        </p>
        <a class="source-link" href={`${pimbas.data.repo}/tree/${pimbas.data.commit}`}>
          Fonte: código e histórico do Pimbas
        </a>
        <a
          class="text-link"
          href={`/projects/${pimbas.id}`}
          aria-label={`Ler estudo de caso: ${pimbas.data.title}`}
        >
          Ler estudo de caso <Arrow />
        </a>
      </div>
      <PimbasComparison />
      <p class="study-limit">{projectReadings.pimbas.limit}</p>
    </article>

    <article class="project-study study-maybe" aria-labelledby="maybe-title">
      <div class="study-intro">
        <p class="project-category">{maybe.data.category}</p>
        <h3 id="maybe-title">
          <a href={`/projects/${maybe.id}`}>{maybe.data.title}</a>
        </h3>
        <p class="study-question">{projectReadings.maybe.question}</p>
        <p class="study-problem">{projectReadings.maybe.problem}</p>
        <p class="study-implementation">{projectReadings.maybe.outcome}</p>
        <p class="study-implementation">
          Na integração de ferramentas, contratos explícitos ajudam a distinguir falha, ausência e
          resposta válida.
        </p>
        <a class="source-link" href={`${maybe.data.repo}/tree/${maybe.data.commit}`}>
          Fonte: API pública do Maybe
        </a>
        <a
          class="text-link"
          href={`/projects/${maybe.id}`}
          aria-label={`Ler estudo de caso: ${maybe.data.title}`}
        >
          Ler estudo de caso <Arrow />
        </a>
      </div>
      <div class="contract-study">
        <p>Dois contratos, duas responsabilidades</p>
        <dl class="contract-definitions">
          <div>
            <dt>Result</dt>
            <dd>
              <strong>Ok / Err</strong>
              <span>Sucesso ou erro</span>
            </dd>
          </div>
          <div>
            <dt>Option</dt>
            <dd>
              <strong>Some / None</strong>
              <span>Presença ou ausência</span>
            </dd>
          </div>
        </dl>
        <p class="contract-note">A entrada passa por Schema e DTO. O núcleo permanece síncrono.</p>
      </div>
      <p class="study-limit">{projectReadings.maybe.limit}</p>
    </article>

    <div class="more-work">
      <h3>Outras investigações</h3>
      {complementary.map((entry) => (
        <article class="project-row">
          <div>
            <p class="project-category">{entry.data.category}</p>
            <h4>
              <a href={`/projects/${entry.id}`}>{entry.data.title}</a>
            </h4>
          </div>
          <div>
            <p>{entry.data.summary}</p>
            <p class="project-row-limit">{entry.data.limits[0]}</p>
          </div>
          <a
            class="text-link"
            href={`/projects/${entry.id}`}
            aria-label={`Ler estudo de caso: ${entry.data.title}`}
          >
            Ler estudo <Arrow />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
