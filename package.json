{
  "name": "gabrielalmir-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:claims": "node scripts/check-claims.mjs dist",
    "test:claims:self": "node scripts/check-claims.mjs --self-test",
    "verify": "npm run check && npm run build && npm run test:claims:self && npm run test:claims && npm run test:e2e",
    "serve": "node scripts/serve-dist.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "generate:brand": "node scripts/generate-social.mjs",
    "format:check": "prettier --check src astro.config.mjs playwright.config.ts tests/e2e/*.ts scripts/*.mjs package.json .prettierrc.json",
    "test:links": "node scripts/check-links.mjs",
    "review:design": "npm run build && node scripts/review-design.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "5.9.3"
  }
}
