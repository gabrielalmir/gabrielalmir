{
  "name": "gabrielalmir-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:claims": "node scripts/check-claims.mjs dist",
    "test:claims:self": "node scripts/check-claims.mjs --self-test",
    "verify": "npm run check && npm run build && npm run test:claims:self && npm run test:claims && npm run test:e2e",
    "serve": "node scripts/serve-dist.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "generate:brand": "node scripts/generate-social.mjs",
    "format:check": "prettier --check src astro.config.mjs playwright.config.ts tests/e2e/*.ts scripts/*.mjs package.json .prettierrc.json",
    "test:links": "node scripts/check-links.mjs",
    "review:design": "npm run build && node scripts/review-design.mjs",
    "security:setup": "bash scripts/install-gitleaks.sh",
    "security:secrets": ".tools/gitleaks dir --config .gitleaks.toml --redact .",
    "security:history": ".tools/gitleaks git --config .gitleaks.toml --redact --log-opts=\"--all\" .",
    "security:audit": "npm audit --audit-level=moderate",
    "security": "npm run security:secrets && npm run security:history && npm run security:audit",
    "prepare": "husky",
    "lint:commits": "commitlint --last",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src scripts tests",
    "lint:unused": "knip",
    "security:semgrep:setup": "bash scripts/install-semgrep.sh",
    "security:semgrep": ".tools/semgrep-venv/bin/semgrep scan --config .semgrep/security.yml --error --strict --metrics=off --disable-version-check src scripts tests",
    "lint": "npm run lint:deps && npm run lint:unused && npm run security:semgrep",
    "prelint:deps": "astro sync"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "dependency-cruiser": "18.7.0",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "5.9.3"
  }
}
